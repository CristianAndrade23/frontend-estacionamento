{
  "name": "estacionamento",
  "version": "2.0.0",
  "type": "module",
  "description": "Painel de gestão de estacionamento em Angular 22 (standalone, zoneless, signals, Signal Forms) com API em Java 25 + Spring Boot 4.",
  "author": "Cristian Andrade",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CristianAndrade23/frontend-estacionamento.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "dev": "node scripts/dev.mjs",
    "start": "ng serve",
    "api": "node scripts/mvnw.mjs -q spring-boot:run",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "node scripts/mvnw.mjs -B test",
    "build:jar": "ng build && node scripts/mvnw.mjs -q -B -Pfrontend package -DskipTests",
    "serve:jar": "java -jar backend/target/estacionamento.jar",
    "serve:prod": "npm run build:jar && npm run serve:jar",
    "cy:open": "node scripts/cypress.mjs open --e2e",
    "cy:run": "node scripts/cypress.mjs run --e2e",
    "e2e": "npm run build:jar && start-server-and-test serve:jar http://localhost:8080/actuator/health cy:run",
    "e2e:open": "npm run build:jar && start-server-and-test serve:jar http://localhost:8080/actuator/health cy:open",
    "docs:screenshots": "npm run build:jar && start-server-and-test serve:jar http://localhost:8080/actuator/health cy:docs",
    "cy:docs": "node scripts/cypress.mjs run --e2e --spec cypress/docs/screenshots.cy.ts --config specPattern=cypress/docs/**/*.cy.ts,screenshotsFolder=cypress/screenshots-docs,retries=0",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"cypress/**/*.ts\""
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "cypress": "^16.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.13",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
