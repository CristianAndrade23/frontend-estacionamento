{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api",
      "type": "npm",
      "script": "api",
      "isBackground": true,
      "problemMatcher": {
        "owner": "java",
        "pattern": { "regexp": "^__never__$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting EstacionamentoApplication",
          "endsPattern": "Started EstacionamentoApplication"
        }
      }
    },
    {
      "label": "web",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "Changes detected" },
          "endsPattern": { "regexp": "bundle generation (complete|failed)" }
        }
      }
    },
    {
      "label": "api + web",
      "dependsOn": ["api", "web"]
    }
  ]
}
